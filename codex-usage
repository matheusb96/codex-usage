#!/usr/bin/env ruby
# frozen_string_literal: true
#
# codex-usage — print ChatGPT Plus / Codex rate-limit usage, `sensors`-style.
#
# Talks to the locally installed Codex CLI through its App Server
# (`codex app-server`, JSON-RPC over stdio, newline-delimited JSON with the
# "jsonrpc" header omitted). Never reads ~/.codex/auth.json and never calls
# ChatGPT HTTP endpoints itself: the App Server does the authenticated fetch.
#
# Protocol (verified against codex-cli 0.149.1 schema + openai/codex source):
#   1. request  initialize            {clientInfo:{name,version}}
#   2. notify   initialized
#   3. request  account/read          {refreshToken:false}   -> planType/email
#   4. request  account/rateLimits/read (no params)          -> rateLimits{primary,secondary,...}
#
# RateLimitWindow: usedPercent (int), windowDurationMins (int|null), resetsAt (unix secs|null)
#
# Exit codes: 0 ok, 1 protocol/usage error, 2 not logged in / not ChatGPT auth,
#             3 codex binary not found, 4 timeout.

require "json"
require "open3"
require "optparse"
require "time"

VERSION = "0.1.0"

class CodexUsageError < StandardError
  attr_reader :exit_code

  def initialize(message, exit_code = 1)
    super(message)
    @exit_code = exit_code
  end
end

# Minimal JSON-RPC client over a spawned `codex app-server` process.
class AppServer
  def initialize(codex_bin:, timeout:, debug:)
    @codex_bin = codex_bin
    @timeout = timeout
    @debug = debug
    @next_id = 0
    @stderr_buf = +""
  end

  def start
    @stdin, @stdout, @stderr, @wait = Open3.popen3(@codex_bin, "app-server")
    @stdin.sync = true
    @stderr_thread = Thread.new { drain_stderr }
  rescue Errno::ENOENT
    raise CodexUsageError.new("codex binary not found (#{@codex_bin}); install Codex CLI or pass --codex PATH", 3)
  end

  # Returns the initialize result ({userAgent, codexHome, platformFamily, platformOs}).
  def handshake
    result = request("initialize", clientInfo: { name: "codex-usage", title: "codex-usage", version: VERSION })
    notify("initialized")
    result
  end

  def request(method, params = nil)
    id = (@next_id += 1)
    msg = { id: id, method: method }
    msg[:params] = params unless params.nil?
    send_line(msg)
    wait_for_response(id, method)
  end

  def notify(method, params = nil)
    msg = { method: method }
    msg[:params] = params unless params.nil?
    send_line(msg)
  end

  # Close stdin (EOF) so the server exits on its own; escalate to TERM/KILL if it lingers.
  def stop
    return unless @wait

    @stdin.close unless @stdin.closed?
    return if reaped?(2)

    signal("TERM")
    return if reaped?(2)

    signal("KILL")
    reaped?(2)
  ensure
    [@stdout, @stderr].each { |io| io&.close unless io.nil? || io.closed? }
    @stderr_thread&.join(0.2)
  end

  def stderr_output
    @stderr_buf
  end

  private

  def send_line(msg)
    line = JSON.generate(msg)
    warn "-> #{line}" if @debug
    @stdin.puts(line)
  rescue Errno::EPIPE, IOError
    raise CodexUsageError.new("app-server closed its stdin unexpectedly#{stderr_hint}", 1)
  end

  def wait_for_response(id, method)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + @timeout
    loop do
      remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
      raise CodexUsageError.new("timed out after #{@timeout}s waiting for #{method}#{stderr_hint}", 4) if remaining <= 0

      ready = IO.select([@stdout], nil, nil, remaining)
      next if ready.nil?

      line = @stdout.gets
      raise CodexUsageError.new("app-server exited before answering #{method}#{stderr_hint}", 1) if line.nil?

      warn "<- #{line.chomp}" if @debug
      msg = begin
        JSON.parse(line)
      rescue JSON::ParserError
        next # not a JSON-RPC frame; ignore
      end

      # Notifications (no id) and server-initiated requests (id + method) are ignored here.
      next unless msg.is_a?(Hash) && msg["id"] == id && !msg.key?("method")

      if (err = msg["error"])
        raise rpc_error(method, err)
      end
      return msg["result"]
    end
  end

  def rpc_error(method, err)
    text = err.is_a?(Hash) ? err["message"].to_s : err.to_s
    code = text =~ /authentication required/i ? 2 : 1
    CodexUsageError.new("#{method} failed: #{text}", code)
  end

  def drain_stderr
    while (chunk = @stderr.read(4096))
      @stderr_buf << chunk
      $stderr.write(chunk) if @debug
    end
  rescue IOError
    nil
  end

  def stderr_hint
    tail = @stderr_buf.strip.lines.last(3).join.strip
    tail.empty? ? "" : "\n  app-server stderr: #{tail}"
  end

  def signal(sig)
    Process.kill(sig, @wait.pid)
  rescue Errno::ESRCH
    nil
  end

  def reaped?(seconds)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + seconds
    until @wait.join(0.05)
      return false if Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
    end
    true
  end
end

# --- Normalisation ----------------------------------------------------------

def window_kind(window)
  mins = window["windowDurationMins"]
  case mins
  when nil then nil
  when 300 then "5h"
  when 10080 then "weekly"
  else
    if mins % 1440 == 0 then "#{mins / 1440}d"
    elsif mins % 60 == 0 then "#{mins / 60}h"
    else "#{mins}m"
    end
  end
end

def window_label(kind)
  case kind
  when "5h" then "5-hour"
  when "weekly" then "weekly"
  else kind
  end
end

def normalize_window(slot, window, now)
  return nil unless window.is_a?(Hash)

  used = window["usedPercent"].to_i.clamp(0, 100)
  resets_at = window["resetsAt"]
  kind = window_kind(window) || slot
  {
    "slot" => slot,
    "kind" => kind,
    "label" => window_label(kind),
    "window_minutes" => window["windowDurationMins"],
    "used_percent" => used,
    "remaining_percent" => 100 - used,
    "resets_at_unix" => resets_at,
    "resets_at" => resets_at && Time.at(resets_at).localtime.iso8601,
    "resets_in_seconds" => resets_at && [resets_at - now.to_i, 0].max
  }
end

def build_report(rate_limits_result, account_result, codex_version, now)
  snapshot = rate_limits_result.fetch("rateLimits", {})
  account = account_result && account_result["account"]

  windows = {}
  [["primary", snapshot["primary"]], ["secondary", snapshot["secondary"]]].each do |slot, w|
    nw = normalize_window(slot, w, now)
    next unless nw

    key = windows.key?(nw["kind"]) ? slot : nw["kind"]
    windows[key] = nw
  end

  extra_buckets = (rate_limits_result["rateLimitsByLimitId"] || {}).reject { |id, _| id == snapshot["limitId"] }

  {
    "ok" => true,
    "fetched_at" => now.iso8601,
    "codex_version" => codex_version,
    "account_type" => account && account["type"],
    "email" => account && account["email"],
    "plan_type" => snapshot["planType"] || (account && account["planType"]),
    "limit_id" => snapshot["limitId"],
    "limit_name" => snapshot["limitName"],
    "windows" => windows,
    "credits" => snapshot["credits"],
    "rate_limit_reached_type" => snapshot["rateLimitReachedType"],
    "spend_control_reached" => snapshot["spendControlReached"],
    "individual_limit" => snapshot["individualLimit"],
    "ordinary_usage_allowed" => rate_limits_result["ordinaryUsageAllowed"],
    "reset_credits_available" => rate_limits_result.dig("rateLimitResetCredits", "availableCount"),
    "other_buckets" => extra_buckets.keys
  }
end

# --- Human output -----------------------------------------------------------

def humanize_duration(seconds)
  return "now" if seconds.nil? || seconds <= 0

  d, rem = seconds.divmod(86_400)
  h, rem = rem.divmod(3600)
  m = rem / 60
  parts = []
  parts << "#{d}d" if d.positive?
  parts << "#{h}h" if h.positive?
  parts << "#{m}m" if m.positive? && d.zero?
  parts.empty? ? "<1m" : parts.join(" ")
end

def bar(used, width = 20)
  filled = (used * width / 100.0).round
  "[" + ("#" * filled) + ("." * (width - filled)) + "]"
end

def print_human(report)
  puts "codex-chatgpt"
  puts "Adapter: Codex App Server (#{report['codex_version'] || 'codex'})"

  plan = report["plan_type"] || "n/a"
  plan_line = "plan:      #{plan}"
  plan_line += "  (#{report['account_type']} auth)" if report["account_type"] && report["account_type"] != "chatgpt"
  puts plan_line

  %w[5h weekly].each do |kind|
    w = report["windows"][kind]
    if w.nil?
      puts format("%-10s n/a", "#{window_label(kind)}:")
      next
    end
    print_window(w)
  end
  report["windows"].each_value { |w| print_window(w) unless %w[5h weekly].include?(w["kind"]) }

  credits = report["credits"]
  if credits.is_a?(Hash)
    credit_text = if credits["unlimited"] then "unlimited"
                  elsif credits["hasCredits"] then "balance #{credits['balance']}"
                  else "none"
                  end
    puts "credits:   #{credit_text}"
  end

  puts "limit:     #{report['rate_limit_reached_type']}" if report["rate_limit_reached_type"]
  puts "spend cap: reached" if report["spend_control_reached"] == true
  if (rc = report["reset_credits_available"]) && rc.positive?
    puts "resets:    #{rc} earned reset credit#{rc == 1 ? '' : 's'} available"
  end
  puts "buckets:   +#{report['other_buckets'].join(', ')}" unless report["other_buckets"].empty?
end

def print_window(w)
  used = w["used_percent"]
  reset = if w["resets_at_unix"]
            t = Time.at(w["resets_at_unix"]).localtime
            rel = w["resets_in_seconds"].to_i <= 0 ? "now" : "in #{humanize_duration(w['resets_in_seconds'])}"
            "resets #{t.strftime('%a %Y-%m-%d %H:%M %Z')} (#{rel})"
          else
            "reset time n/a"
          end
  puts format("%-10s %3d%% used  %3d%% left  %s  %s", "#{w['label']}:", used, w["remaining_percent"], bar(used), reset)
end

# --- Main -------------------------------------------------------------------

options = { json: false, raw: false, timeout: 20, codex: ENV.fetch("CODEX_BIN", "codex"), debug: false }
OptionParser.new do |o|
  o.banner = "Usage: codex-usage [--json | --raw] [--timeout SECS] [--codex PATH] [--debug]"
  o.on("--json", "Print normalized JSON (for scripts)") { options[:json] = true }
  o.on("--raw", "Print the untouched account/rateLimits/read result as JSON") { options[:raw] = true }
  o.on("--timeout SECS", Float, "Per-request timeout (default 20)") { |v| options[:timeout] = v }
  o.on("--codex PATH", "Path to the codex binary (default: $CODEX_BIN or `codex` on PATH)") { |v| options[:codex] = v }
  o.on("--debug", "Echo JSON-RPC traffic and app-server stderr") { options[:debug] = true }
  o.on("-v", "--version") { puts "codex-usage #{VERSION}"; exit 0 }
  o.on("-h", "--help") { puts o; exit 0 }
end.parse!

server = AppServer.new(codex_bin: options[:codex], timeout: options[:timeout], debug: options[:debug])
%w[INT TERM].each { |sig| trap(sig) { server.stop; exit 130 } }

begin
  server.start
  init = server.handshake
  codex_version = init.is_a?(Hash) && init["userAgent"].to_s[%r{codex-usage/([\w.\-]+)}, 1]
  codex_version = codex_version ? "codex-cli #{codex_version}" : nil

  account = begin
    server.request("account/read", refreshToken: false)
  rescue CodexUsageError => e
    warn "warning: account/read failed (#{e.message}); continuing" if options[:debug]
    nil
  end

  rate_limits = server.request("account/rateLimits/read")
  now = Time.now

  if options[:raw]
    puts JSON.pretty_generate(rate_limits)
  else
    report = build_report(rate_limits, account, codex_version, now)
    if options[:json]
      puts JSON.pretty_generate(report)
    else
      print_human(report)
    end
  end
  exit 0
rescue CodexUsageError => e
  if options[:json] || options[:raw]
    puts JSON.generate("ok" => false, "error" => e.message, "exit_code" => e.exit_code)
  else
    warn "codex-usage: #{e.message}"
  end
  exit e.exit_code
ensure
  server.stop
end
